    },
    {
      "parameter": "compare.register.rotation_step_deg",
      "mapping": "direct"
    },
    {
      "parameter": "compare.register.translation_limit",
      "mapping": "direct"
    },
    {
      "parameter": "compare.cmc.down_threshold",
      "mapping": "direct"
    },
    {
      "parameter": "compare.cmc.across_threshold",
      "mapping": "direct"
    },
    {
      "parameter": "compare.cmc.rotation_threshold_deg",
      "mapping": "direct"
    },
    {
      "parameter": "compare.cmc.correlation_threshold",
      "mapping": "direct"
    },
    {
      "parameter": "compare.cmc.consensus",
      "mapping": "direct"
    },
    {
      "parameter": "compare.cmc.translation_bin",
      "mapping": "controlled",
      "by": "compare.cmc.consensus",
      "why": "only the histogram mode consensus has bins to set"
    },
    {
      "parameter": "compare.cmc.rotation_bin_deg",
      "mapping": "controlled",
      "by": "compare.cmc.consensus",
