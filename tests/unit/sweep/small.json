{
  "name": "small",
  "version": "1",
  "description": "A design small enough to run inside the gate, which is what it is for. It moves one parameter of the chain and one of the search around the reproduction profile, on one matching and one non-matching pair. Both were chosen because they move the score on this surface, so a cell whose assignment never reached the pipeline would show as a table of identical rows. Nothing here is a result and this is not a preregistered design; that is #79.",
  "generator": "one-at-a-time",
  "profile": "../../../profiles/published-chain.json",
  "surface": {
    "rows": 192,
    "columns": 192,
    "pixel_spacing_um": 2.0,
    "striae_depth_um": 2.0,
    "striae_spacing_um": 40.0,
    "striae_angle_deg": 0.0,
    "form_depth_um": 12.0,
    "firing_pin_radius_um": 40.0,
    "firing_pin_depth_um": 25.0,
    "drag_mark_width_um": 30.0,
    "drag_mark_depth_um": 6.0,
    "drag_mark_position": 0.25,
    "noise_um": 0.2,
    "edge_dropout_fraction": 0.0
  },
  "search": {
    "grid": 3,
    "minimum_valid": 0.4,
    "rotation_range_deg": 2.0,
    "rotation_step_deg": 2.0,
    "translation_limit": 4
  },
  "rule": {
    "down_threshold": 6.0,
    "across_threshold": 6.0,
    "rotation_threshold_deg": 2.0,
    "correlation_threshold": 0.3,
    "consensus": "median",
    "translation_bin": null,
    "rotation_bin_deg": null
  },
  "pairs": [
    {
      "name": "same-source",
      "kind": "matching",
      "seed": 20260809
    },
    {
      "name": "different-source",
      "kind": "non-matching",
      "seed": 20260810
    }
  ],
  "vary": [
    {
      "parameter": "trim-edge.width",
      "values": [
        40.0,
        120.0
      ]
    },
    {
      "parameter": "compare.register.grid",
      "values": [
        3,
        5
      ]
    }
  ]
}
